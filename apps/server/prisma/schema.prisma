// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String  @unique
  password String
  avatar   String?
  bio      String?
  role     String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  streams       Stream[]
  chatMessages  ChatMessage[]
  recordings    Recording[]
  notifications Notification[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  creatorModerators  Moderator[] @relation("CreatorModerators")
  assignedModerators Moderator[] @relation("AssignedModerators")

  moderatorActions ModerationLog[] @relation("ModeratorActions")
  moderatedUsers   ModerationLog[] @relation("ModeratedUser")
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  // Relations
  streams Stream[]
}

model Stream {
  id          String  @id @default(uuid())
  title       String
  description String?
  streamKey   String  @unique
  thumbnail   String?
  visibility  String
  status      String

  creatorId  String
  categoryId String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator  User     @relation(fields: [creatorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  chatMessages ChatMessage[]
  recording    Recording?
  analytics    Analytics?

  @@index([creatorId])
  @@index([categoryId])
  @@index([status])
  @@index([creatorId, createdAt])
  @@index([categoryId, status])
}

model Follow {
  followerId String
  creatorId  String

  followedAt DateTime @default(now())

  // Relations
  follower User @relation("Following", fields: [followerId], references: [id])
  creator  User @relation("Followers", fields: [creatorId], references: [id])

  @@id([followerId, creatorId])
}

model ChatMessage {
  id       String @id @default(uuid())
  streamId String
  senderId String
  message  String

  createdAt DateTime @default(now())

  // Relations
  stream Stream @relation(fields: [streamId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])

  @@index([streamId])
  @@index([senderId])
  @@index([streamId, createdAt])
}

model Recording {
  id        String @id @default(uuid())
  streamId  String @unique
  creatorId String

  videoUrl  String
  duration  Int
  thumbnail String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stream  Stream @relation(fields: [streamId], references: [id])
  creator User   @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
}

model Notification {
  id     String @id @default(uuid())
  userId String

  type    String
  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Moderator {
  id          String @id @default(uuid())
  creatorId   String
  moderatorId String

  assignedAt DateTime @default(now())

  // Relations
  creator   User @relation("CreatorModerators", fields: [creatorId], references: [id])
  moderator User @relation("AssignedModerators", fields: [moderatorId], references: [id])
}

model ModerationLog {
  id          String @id @default(uuid())
  moderatorId String
  userId      String

  action String
  reason String

  createdAt DateTime @default(now())

  // Relations
  moderator User @relation("ModeratorActions", fields: [moderatorId], references: [id])
  user      User @relation("ModeratedUser", fields: [userId], references: [id])
}

model Analytics {
  id       String @id @default(uuid())
  streamId String @unique

  peakViewers      Int
  averageWatchTime Float
  totalMessages    Int
  totalViews       Int

  createdAt DateTime @default(now())

  // Relations
  stream Stream @relation(fields: [streamId], references: [id])
}
