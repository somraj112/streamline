generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VIEWER
  CREATOR
  MODERATOR
}

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum NotificationType {
  LIVE
  FOLLOW
  SYSTEM
  REMINDER
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String  @unique
  passwordHash String
  profileImage String?
  bio          String?

  role Role @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations

  streams Stream[]

  following Follow[] @relation("FollowerRelation")
  followers Follow[] @relation("CreatorRelation")

  chatMessages ChatMessage[]

  notificationsReceived Notification[] @relation("NotificationReceiver")
  notificationsSent     Notification[] @relation("NotificationSender")

  viewHistory ViewHistory[]

  moderatedStreams Moderator[]

  bans Ban[]
}

model Category {
  id String @id @default(uuid())

  name String @unique
  icon String
}

model Stream {
  id String @id @default(uuid())

  creatorId String

  title       String
  description String?
  category    String

  visibility Visibility
  status     StreamStatus

  streamKey String @unique

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator User @relation(fields: [creatorId], references: [id])

  chatMessages ChatMessage[]

  recording Recording?

  analytics StreamAnalytics?

  moderators Moderator[]

  bans Ban[]

  viewHistory ViewHistory[]

  streamTags StreamTagMap[]

  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
  @@index([creatorId, createdAt])
}

model Follow {
  id String @id @default(uuid())

  followerId String
  creatorId  String

  followedAt DateTime @default(now())

  follower User @relation("FollowerRelation", fields: [followerId], references: [id])
  creator  User @relation("CreatorRelation", fields: [creatorId], references: [id])

  @@unique([followerId, creatorId])
  @@index([followerId])
  @@index([creatorId])
}

model ChatMessage {
  id String @id @default(uuid())

  streamId String
  senderId String

  message String

  deleted Boolean @default(false)

  createdAt DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])

  @@index([streamId])
  @@index([senderId])
}

model Notification {
  id String @id @default(uuid())

  receiverId String
  senderId   String

  type NotificationType

  title String
  body  String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  receiver User @relation("NotificationReceiver", fields: [receiverId], references: [id])
  sender   User @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([receiverId])
  @@index([senderId])
}

model Recording {
  id String @id @default(uuid())

  streamId String @unique

  videoUrl  String
  thumbnail String

  duration Int

  createdAt DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id])

  @@index([streamId])
}

model ViewHistory {
  id String @id @default(uuid())

  userId   String
  streamId String

  watchDuration Int

  viewedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  stream Stream @relation(fields: [streamId], references: [id])

  @@index([userId])
  @@index([streamId])
}

model StreamAnalytics {
  id String @id @default(uuid())

  streamId String

  peakViewers      Int
  averageWatchTime Int
  totalMessages    Int
  totalViews       Int

  stream Stream @relation(fields: [streamId], references: [id])

  @@unique([streamId])
}

model Ban {
  id String @id @default(uuid())

  streamId String
  userId   String

  reason String

  bannedAt DateTime @default(now())

  stream Stream @relation(fields: [streamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([streamId])
  @@index([userId])
}

model StreamTag {
  id String @id @default(uuid())

  name String @unique

  streams StreamTagMap[]
}

model StreamTagMap {
  streamId String
  tagId    String

  stream Stream    @relation(fields: [streamId], references: [id])
  tag    StreamTag @relation(fields: [tagId], references: [id])

  @@id([streamId, tagId])
}

model Moderator {
  id String @id @default(uuid())

  streamId String
  userId   String

  stream Stream @relation(fields: [streamId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([streamId, userId])
  @@index([streamId])
  @@index([userId]) 
}
